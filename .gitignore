# Printer credentials — PRD §9: never committed.
.env
.env.*
# ...but the template IS committed. Measured (correction C9): `.env.*` matches `.env.example`,
# so without this negation the file is invisible to every clone. The negation must come AFTER
# the pattern it undoes; before it, it does nothing.
!.env.example

# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# Generated geometry and images — models are programs; outputs are rebuildable.
out/
renders/

# Node / viewer
node_modules/
viewer/dist/

# Claude Code local (machine-specific) settings. The committed gate lives in
# .claude/settings.json — see ADR-5.
.claude/settings.local.json
