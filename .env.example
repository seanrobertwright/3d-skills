# Printer credentials. Copy to `.env` and fill in. `.env` is gitignored and `Read(.env)` is
# denied at the harness layer (.claude/settings.json) — the values are read in-process by
# `threedp.printer.credentials()` and never enter a transcript.
#
# All three are on the printer itself: Settings -> WLAN.
#
# ⚠ THE ACCESS CODE CHANGES WHEN YOU TOGGLE DEVELOPER MODE. If a dispatch starts failing right
#   after you enable (or disable) LAN Developer Mode, the code in this file is the stale one.
#   Re-read it off the printer screen and update `.env` before debugging anything else.

PRINTER_IP=
PRINTER_SERIAL=
PRINTER_ACCESS_CODE=
